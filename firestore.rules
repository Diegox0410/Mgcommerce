rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'OWNER_UID_TO_CONFIGURE';
    }

    match /publicCatalog/{productId} {
      allow read: if resource.data.status == 'active';
      allow write: if isOwner();
    }

    match /publicStoreConfig/main {
      allow read: if true;
      allow write: if isOwner();
    }

    match /products/{document=**} { allow read, write: if isOwner(); }
    match /inventory/{document=**} { allow read, write: if isOwner(); }
    match /inventoryMovements/{document=**} { allow read, write: if isOwner(); }
    match /inventoryBatches/{document=**} { allow read, write: if isOwner(); }
    match /orders/{document=**} { allow read, write: if isOwner(); }
    match /customers/{document=**} { allow read, write: if isOwner(); }
    match /promotions/{document=**} { allow read, write: if isOwner(); }
    match /taxonomy/{document=**} { allow read, write: if isOwner(); }
    match /storeConfig/{document=**} { allow read, write: if isOwner(); }
    match /businessSettings/{document=**} { allow read, write: if isOwner(); }

    match /{document=**} { allow read, write: if false; }
  }
}
